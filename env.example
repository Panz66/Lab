# Application
APP_NAME=MicroCount
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-to-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./microcount.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/microcount

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Model
YOLO_MODEL_PATH=weights/colony_yolo11.pt
YOLO_CONFIDENCE_THRESHOLD=0.40
YOLO_NMS_IOU_THRESHOLD=0.45
YOLO_IMG_SIZE=640
DEVICE=cpu  # cuda or cpu

# Reports
REPORT_DIR=reports
PDF_REPORT_DIR=reports/pdf
CSV_REPORT_DIR=reports/csv
JSON_REPORT_DIR=reports/json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/microcount.log

GEMINI_API_KEY=Key...